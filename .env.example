# Copy to .env for local development (never commit the real .env).
# Local default is a SQLite file, so DATABASE_URL is optional while developing.
# Production: a Postgres connection string, e.g. from Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Set to 1 in production (HTTPS) so the login cookie is only sent over HTTPS.
COOKIE_SECURE=0

# Timezone used for appointment times.
CLINIC_TZ=America/Los_Angeles
